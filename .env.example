# Copy to .env to override the defaults used by docker compose.

# Where workers deliver notifications. By default they use the bundled mock
# provider. To use webhook.site as in the assessment brief, create a URL there
# (see "Using webhook.site" in the README) and set it here, e.g.
# PROVIDER_URL=https://webhook.site/0b8f1c2e-1234-4d6e-9abc-0123456789ab
PROVIDER_URL=http://mockprovider:8090/send

# Per-channel delivery ceiling, shared by all workers through Redis.
RATE_LIMIT_PER_SECOND=100

# Host port of the operator console.
CONSOLE_PORT=8070

# Number of worker replicas.
WORKER_REPLICAS=2

# Mock provider behaviour at start-up (adjustable live from the console).
MOCK_FAILURE_RATE=0.03
MOCK_MIN_LATENCY_MS=30
MOCK_MAX_LATENCY_MS=150
